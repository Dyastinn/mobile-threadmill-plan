# Node / Expo
node_modules/
.expo/
dist/
web-build/
*.tsbuildinfo
npm-debug.*
yarn-error.*

# Native projects are generated by `npx expo prebuild` (Continuous Native
# Generation). Never edit or commit them; change app.json or a config plugin instead.
# (src/modules/*/android/ is different: a local Expo module's Kotlin is real
# source code, and these two patterns don't match it.)
src/android/
src/ios/

# Visual Studio / Rider / JetBrains / VS Code local state
.vs/
.idea/
.vscode/*
!.vscode/extensions.json

# macOS
.DS_Store

# Android build outputs
*.apk
*.aab
*.keystore
!debug.keystore

# App-private data that never belongs in source control
*.db
*.db-shm
*.db-wal
