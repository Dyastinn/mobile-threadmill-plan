<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MyHi.Companion"
             xmlns:shared="clr-namespace:MyHi.Companion.Features.Shared"
             x:Class="MyHi.Companion.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <shared:NotNullConverter x:Key="NotNullConverter" />
            <shared:InverseBoolConverter x:Key="InverseBoolConverter" />
            <shared:ScanButtonTextConverter x:Key="ScanButtonTextConverter" />
            <shared:FtmsBadgeConverter x:Key="FtmsBadgeConverter" />
            <shared:YesNoConverter x:Key="YesNoConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
