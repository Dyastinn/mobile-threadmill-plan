<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:diag="clr-namespace:MyHi.Companion.Features.Diagnostics"
             x:Class="MyHi.Companion.Features.Diagnostics.ReadDumpPage"
             x:DataType="diag:ReadDumpViewModel"
             Title="Read Dump">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Copy All" Command="{Binding CopyAllCommand}" />
    </ContentPage.ToolbarItems>

    <Grid Padding="16" RowDefinitions="Auto,Auto,*" RowSpacing="10">
        <Button Grid.Row="0" Text="Dump All" Command="{Binding DumpAllCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
        <Label Grid.Row="1" Text="{Binding StatusMessage}" FontSize="12" Opacity="0.8" />

        <CollectionView Grid.Row="2" ItemsSource="{Binding Rows}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="diag:ReadDumpRow">
                    <Grid Padding="0,6" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label FontSize="13">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding ServiceUuid}" FontAttributes="Bold" />
                                        <Span Text="/" />
                                        <Span Text="{Binding CharUuid}" FontAttributes="Bold" />
                                        <Span Text="  " />
                                        <Span Text="{Binding Name}" FontAttributes="Italic" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Text="{Binding Length, StringFormat='{0} bytes'}" FontSize="11" Opacity="0.65" />
                            <Label Text="{Binding Hex}" FontSize="12" FontFamily="Courier" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Copy" FontSize="11" Clicked="OnCopyRowClicked" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
