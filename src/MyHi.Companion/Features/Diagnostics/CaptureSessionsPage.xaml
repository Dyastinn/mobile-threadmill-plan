<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:diag="clr-namespace:MyHi.Companion.Features.Diagnostics"
             x:Class="MyHi.Companion.Features.Diagnostics.CaptureSessionsPage"
             x:DataType="diag:CaptureSessionsViewModel"
             Title="Capture Sessions">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="New Session" Command="{Binding StartNewSessionCommand}" />
    </ContentPage.ToolbarItems>

    <CollectionView Margin="16" ItemsSource="{Binding Sessions}">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="diag:CaptureSessionSummary">
                <Grid Padding="0,10" ColumnDefinitions="*,Auto,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="{Binding FileName}" FontAttributes="Bold" />
                        <Label FontSize="11" Opacity="0.7">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding EventCount}" />
                                    <Span Text=" events, " />
                                    <Span Text="{Binding SizeBytes}" />
                                    <Span Text=" bytes" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Share" Clicked="OnShareClicked" />
                    <Button Grid.Column="2" Text="Delete" Clicked="OnDeleteClicked" />
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>
