<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:diag="clr-namespace:MyHi.Companion.Features.Diagnostics"
             x:Class="MyHi.Companion.Features.Diagnostics.ProbeChecklistPage"
             x:DataType="diag:ProbeChecklistViewModel"
             Title="Probe Checklist">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Export" Command="{Binding ExportCommand}" />
        <ToolbarItem Text="Save" Command="{Binding SaveCommand}" />
    </ContentPage.ToolbarItems>

    <Grid Padding="16" RowDefinitions="Auto,*">
        <Label Grid.Row="0" Text="{Binding StatusMessage}" FontSize="12" Opacity="0.85" Margin="0,0,0,8" />

        <CollectionView Grid.Row="1"
                         ItemsSource="{Binding Groups}"
                         IsGrouped="True">
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="diag:ChecklistGroup">
                    <Label Text="{Binding Part}" FontAttributes="Bold" FontSize="16" Padding="0,12,0,4" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="diag:ChecklistStep">
                    <VerticalStackLayout Padding="0,8" Spacing="4">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="{Binding Question}" FontSize="13" />
                            <Label Text="[blocking]" FontSize="12" TextColor="Red" IsVisible="{Binding Blocking}" />
                        </HorizontalStackLayout>
                        <Entry Text="{Binding Answer}" Placeholder="answer" FontSize="13" />
                        <Label Text="pre-filled from live data — confirm or edit" FontSize="10" Opacity="0.6" IsVisible="{Binding IsPreFilled}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
