<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:bt="clr-namespace:MyHi.Companion.Features.Bluetooth"
             xmlns:diag="clr-namespace:MyHi.Companion.Features.Diagnostics"
             x:Class="MyHi.Companion.Features.Diagnostics.GattTreePage"
             x:DataType="diag:GattTreeViewModel"
             Title="GATT Tree">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Refresh" Command="{Binding RefreshCommand}" />
        <ToolbarItem Text="Disconnect" Command="{Binding DisconnectCommand}" />
    </ContentPage.ToolbarItems>

    <Grid Padding="16" RowDefinitions="Auto,*" RowSpacing="10">
        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label Text="{Binding ConnectionState, StringFormat='State: {0}'}" FontAttributes="Bold" />
            <Label Text="{Binding NegotiatedMtu, StringFormat='Negotiated MTU: {0}'}" FontSize="12" Opacity="0.75" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Services}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="bt:GattServiceInfo">
                    <VerticalStackLayout Padding="0,8" Spacing="6">
                        <Label FontAttributes="Bold" FontSize="15">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding ShortUuid}" />
                                    <Span Text=" — " />
                                    <Span Text="{Binding Name}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Characteristics}" Spacing="4" Margin="16,0,0,0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="bt:GattCharacteristicInfo">
                                    <Grid ColumnDefinitions="*,Auto" Padding="0,2">
                                        <Label Grid.Column="0" FontSize="13">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding ShortUuid}" />
                                                    <Span Text=" " />
                                                    <Span Text="{Binding Name}" FontAttributes="Italic" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label Grid.Column="1" Text="{Binding Properties}" FontSize="11" Opacity="0.7" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
