<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>

		<OutputType>Exe</OutputType>
		<RootNamespace>MyHi.Companion</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

		<!-- Display name -->
		<ApplicationTitle>MyHi Companion (Probe)</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.myhi.companion</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- minSdk 31 / target 36 per 00-Project-Plan.md and phases/phase-00-probe-app/TASKS.md 0.1 -->
		<SupportedOSPlatformVersion>31.0</SupportedOSPlatformVersion>
		<TargetPlatformVersion>36.0</TargetPlatformVersion>
		<AndroidTargetSdkVersion>36</AndroidTargetSdkVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1B1B1B" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
		<PackageReference Include="Plugin.BLE" Version="3.1.0" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
		<!-- Override the transitive 2.1.11 pull, which has a known high-severity advisory (GHSA-2m69-gcr7-jv3q). -->
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MyHi.Companion.Core\MyHi.Companion.Core.csproj" />
	</ItemGroup>

</Project>
